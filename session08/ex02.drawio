        <mxCell id="ei4YBkqNS0rbqvHUc4lH-1" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontStyle=0;fontSize=14;fontFamily=Times New Roman;" value="&lt;br&gt;&lt;span&gt;Những thuộc tính đang bị khai báo trùng lặp ở cả 2 lớp:&lt;/span&gt; &lt;code&gt;maNhanVien&lt;/code&gt;, &lt;code&gt;hoTen&lt;/code&gt;, &lt;code&gt;soDienThoai&lt;/code&gt;.&lt;br&gt;&lt;br&gt;&lt;div&gt;&lt;span&gt;Hậu quả của việc trùng lặp này:&lt;/span&gt; Khi cần thay đổi cấu trúc của thuộc tính (ví dụ: tách &lt;code&gt;hoTen&lt;/code&gt; thành &lt;code&gt;ho&lt;/code&gt; và &lt;code&gt;ten&lt;/code&gt;), lập trình viên sẽ phải sửa đổi thủ công ở tất cả các lớp nhân sự (&lt;code&gt;BacSi&lt;/code&gt;, &lt;code&gt;YTa&lt;/code&gt;, và các vai trò khác sau này), gây mất thời gian, dễ bỏ sót và rất khó bảo trì (vi phạm nguyên tắc DRY - Don&#39;t Repeat Yourself).&lt;/div&gt;" vertex="1">
          <mxGeometry height="130" width="420" x="40" y="40" as="geometry" />
        </mxCell>
